{
  "mcpServers": {
    "ruflo": {
      "command": "npx",
      "args": ["-y", "ruflo@latest", "mcp", "start"],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    },
    "graphify": {
      "comment": "Adjust command to your graphify install (pip/uvx). Remove if unused.",
      "command": "uvx",
      "args": ["graphifyy", "mcp", "start"],
      "autoStart": false
    },
    "gsd-workflow": {
      "comment": "GSD-Pi workflow MCP — set GSD_WORKFLOW_PROJECT_ROOT to client repo root",
      "command": "node",
      "args": ["$GSD_PI_ROOT/packages/mcp-server/dist/cli.js"],
      "cwd": "/absolute/path/to/client-repo",
      "env": {
        "GSD_CLI_PATH": "gsd",
        "GSD_BIN_PATH": "gsd",
        "GSD_WORKFLOW_EXECUTORS_MODULE": "$GSD_AGENT_EXTENSIONS/gsd/tools/workflow-tool-executors.js",
        "GSD_WORKFLOW_WRITE_GATE_MODULE": "$GSD_AGENT_EXTENSIONS/gsd/bootstrap/write-gate.js",
        "GSD_PERSIST_WRITE_GATE_STATE": "1",
        "GSD_WORKFLOW_PROJECT_ROOT": "/absolute/path/to/client-repo"
      },
      "autoStart": false
    }
  }
}
