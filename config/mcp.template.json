{
  "mcpServers": {
    "ruflo": {
      "command": "npx",
      "args": ["-y", "ruflo@latest", "mcp", "start"],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    },
    "graphify": {
      "comment": "Adjust command to your graphify install (pip/uvx). Remove if unused.",
      "command": "uvx",
      "args": ["graphifyy", "mcp", "start"],
      "autoStart": false
    },
    "gsd-workflow": {
      "comment": "Cursor GSD-Pi — configure per @opengsd/gsd-pi docs",
      "autoStart": false
    }
  }
}
